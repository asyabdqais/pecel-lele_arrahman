---
import { restaurantData, createWhatsAppOrderUrl } from '../data/restaurant';

const directOrderUrl = createWhatsAppOrderUrl();
---

<section id="kontak" class="py-16 md:py-24 bg-[#FFF9F0] border-b border-brand-border/60">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center reveal-on-scroll">
      <!-- Badge -->
      <div class="tag-badge mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
        <span>Lokasi & Pemesanan</span>
      </div>

      <!-- Heading (DM Serif Display) -->
      <h2 class="font-editorial text-3xl sm:text-4xl lg:text-5xl text-brand-dark tracking-tight">
        Hubungi Pecel Lele Al Rahman
      </h2>

      <!-- Subtitle — tidak mengulangi nama bisnis -->
      <p class="mt-4 text-sm sm:text-base text-brand-muted leading-relaxed max-w-xl">
        Pesan langsung via WhatsApp, kunjungi kami di KM 24, atau buka rute di Google Maps.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Contact Details (5 cols) — Kartu Nama Usaha dihapus -->
      <div class="lg:col-span-5 flex flex-col gap-4 reveal-on-scroll">

        <!-- Card: WhatsApp Pemesanan -->
        <a
          href={directOrderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 sm:p-6 rounded-2xl bg-white border border-brand-border shadow-editorial hover:border-brand-red/50 hover:shadow-hoverCard transition-all duration-300 flex items-start gap-4 group"
        >
          <div class="w-11 h-11 rounded-xl bg-brand-surface text-brand-red group-hover:bg-brand-red group-hover:text-white transition-colors flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </div>
          <div>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-muted">WhatsApp Pemesanan</span>
            <h3 class="font-editorial text-xl text-brand-dark group-hover:text-brand-red transition-colors mt-0.5">
              {restaurantData.phoneFormatted}
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted mt-0.5">Pesan di tempat, takeaway, atau porsi banyak.</p>
          </div>
        </a>

        <!-- Card: Alamat Warung -->
        <div class="p-5 sm:p-6 rounded-2xl bg-white border border-brand-border shadow-editorial flex items-start gap-4">
          <div class="w-11 h-11 rounded-xl bg-brand-surface text-brand-red flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-muted">Alamat</span>
            <h3 class="font-editorial text-base sm:text-lg text-brand-dark mt-0.5">{restaurantData.address}</h3>
            <p class="text-xs sm:text-sm text-brand-muted mt-0.5">Tepi jalan lintas utama, parkir luas motor & mobil.</p>
          </div>
        </div>

        <!-- Row: Instagram & Jam Buka -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Instagram -->
          <a
            href={restaurantData.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-2xl bg-white border border-brand-border shadow-editorial hover:border-brand-red/50 hover:shadow-hoverCard transition-all duration-300 flex flex-col gap-2 group"
          >
            <div class="w-8 h-8 rounded-lg bg-brand-surface text-brand-dark flex items-center justify-center group-hover:text-brand-red transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2" />
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" stroke-width="2" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2" stroke-linecap="round" />
              </svg>
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-muted">Instagram</span>
              <span class="block text-xs font-semibold text-brand-dark group-hover:text-brand-red transition-colors mt-0.5">
                {restaurantData.instagramHandle}
              </span>
            </div>
          </a>

          <!-- Jam Buka -->
          <div class="p-4 rounded-2xl bg-white border border-brand-border shadow-editorial flex flex-col gap-2">
            <div class="w-8 h-8 rounded-lg bg-brand-surface text-brand-dark flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" stroke-width="2" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 3" />
              </svg>
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-muted">Jam Buka</span>
              <span class="block text-xs font-semibold text-brand-dark mt-0.5">{restaurantData.openingHours}</span>
            </div>
          </div>
        </div>

        <!-- Info strip: lokasi ringkas, tanpa tombol WA -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-brand-deep/90 to-[#731519] text-white flex items-center gap-3">
          <svg class="w-5 h-5 flex-shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-white/70">Jalan Lintas Utama</p>
            <p class="text-sm font-semibold text-white">Pekanbaru – Bangkinang, {restaurantData.locationKm}</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Map & Live Navigation (7 cols) -->
      <div class="lg:col-span-7 reveal-on-scroll delay-150">
        <div class="bg-white rounded-2xl border border-brand-border shadow-editorial overflow-hidden flex flex-col">

          <!-- Map Header Bar -->
          <div class="px-5 py-3.5 border-b border-brand-border/70 bg-[#FCF8F2] flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3">
              <div class="relative flex items-center justify-center w-8 h-8 rounded-lg bg-brand-red/10 text-brand-red flex-shrink-0">
                <span class="animate-ping absolute inline-flex h-3 w-3 rounded-full bg-brand-red opacity-60"></span>
                <svg class="relative w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-editorial text-base text-brand-dark leading-tight">{restaurantData.name}</h3>
                <p class="text-xs text-brand-muted">{restaurantData.address}</p>
              </div>
            </div>
            
            <!-- Quick badge linking to Google Maps -->
            <a
              href={restaurantData.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-red text-white hover:bg-brand-deep transition-colors"
            >
              <span>{restaurantData.locationKm}</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Interactive Google Maps Frame (No Blurry Raster / No Ugly Shadows) -->
          <div class="relative w-full h-80 sm:h-96 bg-[#E8E4DC] overflow-hidden">
            <iframe
              src="https://maps.google.com/maps?q=0.4150,101.2780+(Pecel+Lele+Al+Rahman+KM+24)&t=&z=15&ie=UTF8&iwloc=B&output=embed"
              width="100%"
              height="100%"
              class="w-full h-full border-0"
              loading="lazy"
              allowfullscreen=""
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Interaktif Google Maps Pecel Lele Al Rahman KM 24"
            ></iframe>
          </div>

          <!-- Map Footer: Helpful Location Badges + Navigation CTA -->
          <div class="p-5 bg-white border-t border-brand-border/70 flex flex-col gap-4">
            <!-- Feature Pills -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-brand-dark">
              <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-surface/70 border border-brand-border/60">
                <span class="w-2 h-2 rounded-full bg-brand-red flex-shrink-0"></span>
                <span class="font-medium">Tepi Jalan Lintas Pekanbaru – Bangkinang</span>
              </div>
              <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-brand-surface/70 border border-brand-border/60">
                <span class="w-2 h-2 rounded-full bg-brand-gold flex-shrink-0"></span>
                <span class="font-medium">Area Parkir Luas Motor, Mobil & Minibus</span>
              </div>
            </div>

            <!-- Main Route Button -->
            <a
              href={restaurantData.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full text-center flex items-center justify-center gap-2 py-3"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span>Petunjuk Arah & Buka Google Maps</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
