---
import { restaurantData, createWhatsAppOrderUrl } from '../data/restaurant';

const navLinks = [
  { href: '#beranda', label: 'Beranda' },
  { href: '#tentang', label: 'Tentang Kami' },
  { href: '#menu', label: 'Menu' },
  { href: '#testimoni', label: 'Testimoni' },
  { href: '#kontak', label: 'Kontak' }
];

const orderUrl = createWhatsAppOrderUrl();
---

<header class="sticky top-0 z-50 w-full bg-[#FFF9F0]/95 backdrop-blur-md border-b border-brand-border/80 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Brand Name -->
      <a href="#beranda" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-red rounded-lg py-1">
        <div class="w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img src="/images/logo.svg" alt={`Logo ${restaurantData.name}`} class="w-full h-full object-cover" width="40" height="40" />
        </div>
        <span class="font-editorial text-xl sm:text-2xl text-brand-deep tracking-tight group-hover:text-brand-red transition-colors">
          {restaurantData.name}
        </span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Menu Navigasi Utama">
        {navLinks.map((link, idx) => (
          <a
            href={link.href}
            data-nav-link={link.href.replace('#', '')}
            class:list={[
              "nav-item px-4 py-2 rounded-full text-sm font-medium transition-all duration-200",
              idx === 0
                ? "active-nav text-brand-red font-semibold bg-brand-surface"
                : "text-brand-muted hover:text-brand-dark hover:bg-brand-surface/60"
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Action CTA (No useless profile icon) -->
      <div class="hidden sm:flex items-center">
        <a
          href={orderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          <span>Pesan Sekarang</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={orderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-red text-white"
        >
          Pesan
        </a>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-brand-dark hover:bg-brand-surface focus:outline-none focus:ring-2 focus:ring-brand-red transition-colors"
          aria-label="Buka Menu Navigasi"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-border bg-[#FFF9F0] px-4 pt-3 pb-6 shadow-lg transition-all">
    <div class="space-y-1 flex flex-col">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link px-4 py-2.5 rounded-lg text-base font-medium text-brand-dark hover:bg-brand-surface hover:text-brand-red transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 mt-2 border-t border-brand-border flex flex-col gap-2">
        <a
          href={orderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full text-center"
        >
          <span>Pesan via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer interaction
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Active navigation scroll-spy
  const sections = document.querySelectorAll('section[id]');
  const desktopNavItems = document.querySelectorAll('.nav-item');

  function updateActiveNav() {
    const scrollY = window.pageYOffset;
    sections.forEach((section) => {
      const el = section as HTMLElement;
      const sectionHeight = el.offsetHeight;
      const sectionTop = el.offsetTop - 120;
      const sectionId = el.getAttribute('id');

      if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
        desktopNavItems.forEach((navItem) => {
          if (navItem.getAttribute('data-nav-link') === sectionId) {
            navItem.classList.add('active-nav', 'text-brand-red', 'font-semibold', 'bg-brand-surface');
            navItem.classList.remove('text-brand-muted');
          } else {
            navItem.classList.remove('active-nav', 'text-brand-red', 'font-semibold', 'bg-brand-surface');
            navItem.classList.add('text-brand-muted');
          }
        });
      }
    });
  }

  window.addEventListener('scroll', updateActiveNav, { passive: true });
</script>
