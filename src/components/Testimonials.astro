---
import { testimonialsData } from '../data/testimonials';
---

<section id="testimoni" class="py-16 md:py-24 bg-white border-b border-brand-border/60">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center reveal-on-scroll">
      <!-- Badge -->
      <div class="tag-badge mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-red"></span>
        <span>Ulasan Konsumen</span>
      </div>

      <!-- Heading (DM Serif Display) -->
      <h2 class="font-editorial text-3xl sm:text-4xl lg:text-5xl text-brand-dark tracking-tight">
        Apa Kata Pelanggan Kami?
      </h2>

      <!-- Subtitle -->
      <p class="mt-4 text-sm sm:text-base text-brand-muted leading-relaxed max-w-xl">
        Kepuasan pelanggan menjadi semangat kami untuk terus menyajikan hidangan terbaik dan pelayanan hangat.
      </p>
    </div>

    <!-- 2 Authentic Testimonials (Balanced 2-Col Grid) -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
      {testimonialsData.map((item, idx) => (
        <div class:list={[
          "bg-brand-surface/50 rounded-2xl p-6 sm:p-8 border border-brand-border flex flex-col justify-between hover:border-brand-red/30 transition-all duration-300 shadow-editorial hover:shadow-hoverCard reveal-on-scroll",
          idx === 1 ? "delay-150" : ""
        ]}>
          
          <div>
            <!-- Star Rating in Warm Gold -->
            <div class="flex items-center gap-1 text-brand-gold mb-4" aria-label="Rating 5 dari 5 bintang">
              {Array.from({ length: item.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-sm sm:text-base text-brand-dark leading-relaxed font-normal">
              "{item.text}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="mt-6 pt-5 border-t border-brand-border/80 flex items-center justify-between">
            <div>
              <span class="block text-sm font-semibold text-brand-dark leading-snug">{item.name}</span>
              <span class="block text-xs text-brand-muted mt-0.5">{item.role}</span>
            </div>
            <div class="w-8 h-8 rounded-full bg-brand-surface border border-brand-border/80 flex items-center justify-center text-brand-red/40">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
              </svg>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
